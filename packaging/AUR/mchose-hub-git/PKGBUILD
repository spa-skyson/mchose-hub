pkgname=mchose-hub-git
pkgver=r0.0000000
pkgrel=1
pkgdesc='Linux control hub for MCHOSE V9 Turbo+ headset and RGB dock'
arch=('any') # Pure Python; no architecture-specific binaries are shipped.
url='https://github.com/spa-skyson/mchose-hub'
license=('MIT')
# PyQt6 (python-pyqt6) is required; NR via noise-suppression-for-voice (librnnoise-ladspa) is optional.
depends=('python' 'python-pyqt6')
optdepends=('noise-suppression-for-voice: шумоподавление микрофона (NR)')
makedepends=('git')
source=('git+https://github.com/spa-skyson/mchose-hub.git')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/mchose-hub"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
  cd "$srcdir/mchose-hub"
  install -d "$pkgdir/usr/share/mchose-hub"
  cp -a mchose_hub "$pkgdir/usr/share/mchose-hub/"
  install -Dm644 README.md "$pkgdir/usr/share/mchose-hub/README.md"
  install -Dm644 PROTOCOL.md "$pkgdir/usr/share/mchose-hub/PROTOCOL.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/99-mchose-hub.rules "$pkgdir/usr/lib/udev/rules.d/99-mchose-hub.rules"

  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/mchose-hub.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=MCHOSE Hub
Comment=Control MCHOSE V9 Turbo+ headset and RGB dock
Icon=audio-headphones
Terminal=false
Categories=Utility;Settings;AudioVideo;
Keywords=headset;mchose;
Exec=/usr/bin/mchose-hub
EOF

  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/mchose-hub" <<'EOF'
#!/usr/bin/env bash
exec env PYTHONPATH=/usr/share/mchose-hub python3 -m mchose_hub.gui "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/mchose-hub"
}
