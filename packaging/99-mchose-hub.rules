# Правила udev для доступа к hidraw-устройствам MCHOSE V9 (MODE 0666).
# Установка:
#   sudo cp 99-mchose-hub.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger

# V9 Turbo+ док (RGB-база)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3837", ATTRS{idProduct}=="6008", MODE="0666"

# V9 Turbo+ донгл 2.4G
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3837", ATTRS{idProduct}=="600a", MODE="0666"

# V9 Turbo донгл
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3837", ATTRS{idProduct}=="600d", MODE="0666"

# V9 Pro / V9 / S9 Pro / G9 Pro донгл (совместимость)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="291d", ATTRS{idProduct}=="385d", MODE="0666"
